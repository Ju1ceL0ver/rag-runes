# Runtime files
RAG_ENV_FILE=.env
RAG_SETTINGS_FILE=config/settings.toml

# Server override (optional)
RAG_HOST=
RAG_PORT=

# Path overrides (optional)
RAG_BOOKS_DIR=
RAG_INDEX_DIR=

# Model overrides (optional)
RAG_EMBEDDER=
RAG_RERANKER=
RAG_SEGMENTER_MODE=
GLM_OCR_MODEL=
RAG_SEGMENTER_MODEL=
RAG_ANSWER_MODEL=

# Endpoint overrides (optional)
GLM_OCR_ENDPOINT=
RAG_SEGMENTER_ENDPOINT=
RAG_ANSWER_ENDPOINT=

# Secret keys
GLM_OCR_API_KEY=
RAG_SEGMENTER_API_KEY=
RAG_ANSWER_API_KEY=

# Retrieval/index params (optional)
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
RAG_CONTEXT_CHARS=
RAG_BOOTSTRAP_ON_STARTUP=
